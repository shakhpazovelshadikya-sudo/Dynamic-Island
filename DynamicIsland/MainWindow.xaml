<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="160" Height="34">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="13" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceChip" TargetType="Button">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Выбрать плеер"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1AFFFFFF" CornerRadius="9" Padding="8,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1AFFFFFF" CornerRadius="12" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bg" Property="Background" Value="#F2F2F2"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="danger">
                                <Setter TargetName="Bg" Property="Background" Value="#E0382E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1AFFFFFF" CornerRadius="11" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Island"
            Background="Black"
            CornerRadius="17"
            Width="160" Height="34"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            ClipToBounds="True"
            AllowDrop="True"
            DragEnter="Island_DragEnter"
            DragOver="Island_DragOver"
            DragLeave="Island_DragLeave"
            Drop="Island_Drop"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave"
            MouseLeftButtonUp="Island_Click">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Компактный вид -->
            <Grid x:Name="CompactRoot">
                <!-- Питомец: живёт в левой части капсулы (см. MainWindow.Pet.cs) -->
                <Image x:Name="PetImage" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="6,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PetFlip" ScaleX="1"/>
                            <TranslateTransform x:Name="PetShift"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="PetZ" Text="z" Foreground="#9AA0B5" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,3,0,0"
                           Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="PetZShift"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Текущий язык ввода (RU / EN) -->
                <Border x:Name="CompactLangBadge" Background="#2EFFFFFF" CornerRadius="9" Padding="6,1"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="CompactLang" Foreground="#DDDDDD" FontSize="11" FontWeight="Bold"/>
                </Border>

                <!-- Обложка играющего трека -->
                <Border x:Name="CompactCover" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,7,0" IsHitTestVisible="False" Visibility="Collapsed" Background="#222">
                    <Grid>
                        <TextBlock x:Name="CompactCoverPlaceholder" Text="&#x266B;" FontSize="12" Foreground="#777777"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="CompactCoverImage" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <!-- Хост обрезает текст: если название не влезает даже в максимальную ширину, оно прокручивается (бегущая строка) -->
                <Border x:Name="CompactTextHost" ClipToBounds="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="42,0,14,0">
                    <TextBlock x:Name="CompactText"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <!-- Смена языка: EN → RU -->
            <StackPanel x:Name="LangPanel" Orientation="Horizontal" Opacity="0" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LangFrom" Foreground="#888888" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="→" Foreground="#666666" FontSize="14" Margin="10,0"/>
                <TextBlock x:Name="LangTo" Foreground="White" FontSize="14" FontWeight="Bold" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="LangShift" Y="14"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- Загрузка файла прямо в капсуле: иконка + проценты, затем «Файл установлен» -->
            <Grid x:Name="PillUpload" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                    <Grid Width="26" Height="24" Margin="0,0,9,0">
                        <Image x:Name="PillIcon" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Border x:Name="PillBadge" Visibility="Collapsed" Width="13" Height="13" CornerRadius="7"
                                Background="#2FBF5B" BorderBrush="Black" BorderThickness="1.5"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PillBadgeScale"/></Border.RenderTransform>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="7" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PillText" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="PillBar" Height="3" CornerRadius="1.5" Margin="18,0,18,4" VerticalAlignment="Bottom"
                        Background="#33FFFFFF">
                    <Border x:Name="PillFill" CornerRadius="1.5" Background="#4DA3FF" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="PillFillScale" ScaleX="0"/></Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>

            <!-- Уведомление прямо в капсуле: значок приложения + текст -->
            <Grid x:Name="NotifPanel" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="10" Background="#2A2A30" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="NotifLetter" Foreground="#DDDDDD" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="NotifIcon" Stretch="Uniform" Margin="5"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NotifApp" Foreground="#8A8A93" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NotifTitle" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NotifBody" Foreground="#BBBBBB" FontSize="12" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                </StackPanel>
            </Grid>

            <!-- Развёрнутый вид: вкладки + содержимое -->
            <Grid x:Name="ExpandedView" Opacity="0" Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Вкладки -->
                <StackPanel x:Name="TabBar" Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="TabMain" Style="{StaticResource TabButton}" Content="&#xE80F;" ToolTip="Главная" Tag="selected" Click="TabMain_Click"/>
                    <Button x:Name="TabWeather" Style="{StaticResource TabButton}" Content="&#xE753;" ToolTip="Погода" Click="TabWeather_Click"/>
                    <Button x:Name="TabCalendar" Style="{StaticResource TabButton}" Content="&#xE787;" ToolTip="Календарь" Click="TabCalendar_Click"/>
                    <Button x:Name="TabShelf" Style="{StaticResource TabButton}" Content="&#xE8B7;" ToolTip="Полка" Click="TabShelf_Click"/>
                    <Button x:Name="TabTimer" Style="{StaticResource TabButton}" Content="&#xE121;" ToolTip="Таймер" Click="TabTimer_Click"/>
                    <Button x:Name="TabClipboard" Style="{StaticResource TabButton}" Content="&#xE77F;" ToolTip="Буфер обмена" Click="TabClipboard_Click"/>
                    <Button x:Name="TabSystem" Style="{StaticResource TabButton}" Content="&#xE7E8;" ToolTip="Система" Click="TabSystem_Click"/>
                    <Button x:Name="TabTranslate" Style="{StaticResource TabButton}" Content="&#xE774;" ToolTip="Переводчик" Click="TabTranslate_Click"/>
                </StackPanel>

                <!-- Обновление: видна только когда на GitHub вышла новая версия -->
                <Button x:Name="UpdateButton" Grid.Row="0" Style="{StaticResource ChipButton}" Content="⬆ Обновить"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0"
                        Visibility="Collapsed" Foreground="#7FD99A" Click="Update_Click"/>

                <!-- Кнопка настроек -->
                <Button x:Name="SettingsButton" Grid.Row="0" Style="{StaticResource IconButton}"
                        Content="&#xE713;" FontSize="14" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="#AAAAAA" Click="Settings_Click"/>

                <Grid Grid.Row="1" Margin="0,10,0,0">

                    <!-- Раздел: Главная (плеер) -->
                    <Grid x:Name="MainPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CoverBorder" Grid.Column="0" Width="76" Height="76" Background="#222" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="CoverPlaceholder" Text="&#x266B;" FontSize="30" Foreground="#555555"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <Border ClipToBounds="True">
                                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Border ClipToBounds="True">
                                    <TextBlock x:Name="ArtistText" Foreground="#AAAAAA" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="SourceChip" Style="{StaticResource SourceChip}" Visibility="Collapsed" Margin="0,0,8,0" Click="SourceChip_Click"/>
                                    <TextBlock x:Name="StatusText" Foreground="#777777" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click"/>
                                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" Click="PlayPause_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Прогресс трека и громкость -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TimeCur" Grid.Column="0" Text="0:00" Foreground="#888888" FontSize="10"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <local:MiniSlider x:Name="SeekSlider" Grid.Column="1" Margin="2,0" IsEnabled="False"/>
                            <TextBlock x:Name="TimeDur" Grid.Column="2" Text="0:00" Foreground="#888888" FontSize="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <Button x:Name="VolMute" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE767;"
                                    Width="24" Height="24" FontSize="12" Foreground="#BBBBBB" ToolTip="Без звука" Click="VolMute_Click"/>
                            <local:MiniSlider x:Name="VolSlider" Grid.Column="5" Margin="2,0,0,0" Maximum="1"/>
                        </Grid>
                    </Grid>

                    <!-- Раздел: Погода -->
                    <Grid x:Name="WeatherPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="WeatherIcon" FontFamily="Segoe UI Emoji" FontSize="34" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeatherTemp" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="WeatherCity" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WeatherDesc" Foreground="#AAAAAA" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WeatherDetails" Foreground="#777777" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WeatherRange" Foreground="#777777" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel x:Name="ForecastPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Раздел: Календарь -->
                    <Grid x:Name="CalendarPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CalDay" Foreground="White" FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CalWeekday" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CalWeek" Foreground="#777777" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE76B;" Click="CalPrev_Click"/>
                                <TextBlock x:Name="CalMonth" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold"
                                           Width="86" TextAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                           MouseLeftButtonUp="CalMonth_Click" ToolTip="Вернуться к текущему месяцу"/>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE76C;" Click="CalNext_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid x:Name="CalGrid" Grid.Column="1" Columns="7" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Раздел: Полка (перетащи файл — запускай одним кликом) -->
                    <Grid x:Name="ShelfPanel" Visibility="Collapsed">
                        <TextBlock x:Name="ShelfEmpty"
                                   Text="Перетащи сюда файлы, папки или программы — и запускай одним кликом"
                                   Foreground="#777777" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly" PreviewMouseWheel="ShelfScroll_Wheel">
                            <StackPanel x:Name="ShelfItems" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>

                        <!-- Загрузка файла: проценты -> «Файл установлен» -->
                        <Border x:Name="ShelfProgress" Visibility="Collapsed" IsHitTestVisible="False"
                                Background="#F2101010" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="48" Height="48" Margin="0,0,14,0">
                                    <Image x:Name="ShelfProgressIcon" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Border x:Name="ShelfDoneBadge" Visibility="Collapsed" Width="20" Height="20" CornerRadius="10"
                                            Background="#2FBF5B" BorderBrush="#101010" BorderThickness="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="ShelfBadgeScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Width="190">
                                    <Grid>
                                        <TextBlock x:Name="ShelfProgressTitle" Text="Загрузка…" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ShelfProgressPercent" Text="0%" Foreground="#CCCCCC" FontSize="13"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock x:Name="ShelfProgressName" Foreground="#999999" FontSize="11" Margin="0,2,0,6"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Height="6" CornerRadius="3" Background="#33FFFFFF">
                                        <Border x:Name="ShelfProgressFill" CornerRadius="3" Background="#4DA3FF"
                                                HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="ShelfFillScale" ScaleX="0"/></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ShelfDropHint" Visibility="Collapsed" IsHitTestVisible="False"
                                Background="#E6000000" BorderBrush="#66FFFFFF" BorderThickness="1.5" CornerRadius="14">
                            <TextBlock Text="Отпусти, чтобы добавить на полку" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Раздел: Таймер -->
                    <Grid x:Name="TimerPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TimerText" Foreground="White" FontSize="40" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TimerStateText" Foreground="#777777" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel>
                                <Button Style="{StaticResource ChipButton}" Content="1 мин" Tag="1" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="5 мин" Tag="5" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="10 мин" Tag="10" Click="TimerPreset_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="25 мин" Tag="25" Click="TimerPreset_Click"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ChipButton}" Content="−1 мин" Tag="-1" Click="TimerAdjust_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="+1 мин" Tag="1" Click="TimerAdjust_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TimerPlay" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Старт / пауза" Click="TimerPlay_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Сбросить" Click="TimerReset_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Раздел: Буфер обмена (история текста) -->
                    <Grid x:Name="ClipboardPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ClipEmpty" Grid.ColumnSpan="2"
                                   Foreground="#777777" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <ScrollViewer x:Name="ClipScroll" Grid.Column="0" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <StackPanel x:Name="ClipItems"/>
                        </ScrollViewer>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                                    Content="&#xE74D;" ToolTip="Очистить историю" Foreground="#AAAAAA" Click="ClipClear_Click"/>
                            <TextBlock x:Name="ClipCount" Foreground="#777777" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Раздел: Переводчик -->
                    <Grid x:Name="TranslatePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Button x:Name="TrFromBtn" Style="{StaticResource ChipButton}" Margin="0,0,4,6" Content="Авто ▾" Click="TrFrom_Click"/>
                            <Button Style="{StaticResource ChipButton}" Margin="0,0,4,6" Content="&#x21C4;" ToolTip="Поменять языки местами" Click="TrSwap_Click"/>
                            <Button x:Name="TrToBtn" Style="{StaticResource ChipButton}" Margin="0,0,10,6" Content="English ▾" Click="TrTo_Click"/>
                            <Button Style="{StaticResource ChipButton}" Margin="0,0,4,6" Content="Вставить" Click="TrPaste_Click"/>
                            <Button Style="{StaticResource ChipButton}" Margin="0,0,4,6" Content="Копировать" Click="TrCopy_Click"/>
                            <Button Style="{StaticResource ChipButton}" Margin="0,0,0,6" Content="&#x2715;" ToolTip="Очистить" Click="TrClear_Click"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1AFFFFFF" CornerRadius="10" Padding="8,5">
                                <Grid>
                                    <TextBlock x:Name="TrPlaceholder" Text="Введи или вставь текст" Foreground="#666666" FontSize="12"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="TrInput" Background="Transparent" BorderThickness="0" Foreground="White"
                                             CaretBrush="White" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Hidden" SelectionBrush="#6688CCFF"
                                             PreviewMouseDown="TrInput_PreviewMouseDown" LostKeyboardFocus="TrInput_LostKeyboardFocus"
                                             TextChanged="TrInput_TextChanged" KeyDown="TrInput_KeyDown"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#1AFFFFFF" CornerRadius="10" Padding="8,5">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                        <TextBlock x:Name="TrOutput" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="TrStatus" Foreground="#888888" FontSize="10" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Раздел: Система -->
                    <Grid x:Name="SystemPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Переключатели -->
                        <UniformGrid Grid.Row="0" Columns="3">
                            <Button x:Name="TileWifi" Style="{StaticResource TileButton}" HorizontalContentAlignment="Left" Margin="0,0,6,0" Click="TileWifi_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Параметры Wi-Fi…" Click="OpenWifiSettings_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Wi-Fi" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WifiState" Text="…" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="TileBluetooth" Style="{StaticResource TileButton}" HorizontalContentAlignment="Left" Margin="0,0,6,0" Click="TileBluetooth_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Параметры Bluetooth…" Click="OpenBluetoothSettings_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Bluetooth" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BtState" Text="…" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="TileVpn" Style="{StaticResource TileButton}" HorizontalContentAlignment="Left" Click="TileVpn_Click" ContextMenuOpening="TileVpn_ContextMenuOpening">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="VpnMenu"/>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="VPN" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="VpnState" Text="…" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Питание и громкость -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid Grid.Column="0" Columns="4">
                                <Button Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="Lock_Click" ToolTip="Заблокировать компьютер">
                                    <StackPanel>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Блок." FontSize="10.5" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="Sleep_Click" ToolTip="Режим сна">
                                    <StackPanel>
                                        <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Сон" FontSize="10.5" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRestart" Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="Restart_Click" ToolTip="Перезагрузить (нужно подтверждение)">
                                    <StackPanel>
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RestartLabel" Text="Рестарт" FontSize="10.5" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnShutdown" Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="Shutdown_Click" ToolTip="Выключить компьютер (нужно подтверждение)">
                                    <StackPanel>
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ShutdownLabel" Text="Выкл." FontSize="10.5" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="12" Padding="4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontFamily="Segoe UI" FontSize="18" Content="−" ToolTip="Тише" Click="VolDown_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE767;" ToolTip="Без звука" Click="VolMute_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontFamily="Segoe UI" FontSize="18" Content="+" ToolTip="Громче" Click="VolUp_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
