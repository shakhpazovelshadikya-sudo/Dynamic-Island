<Window x:Class="DynamicIsland.NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        Width="400" SizeToContent="Height">

    <Border x:Name="Card"
            Background="Black"
            CornerRadius="22"
            Width="380"
            Padding="14,12"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Cursor="Hand"
            Opacity="0"
            RenderTransformOrigin="0.5,0"
            MouseEnter="Card_MouseEnter"
            MouseLeave="Card_MouseLeave"
            MouseLeftButtonUp="Card_Click">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale" ScaleX="0.45" ScaleY="0.6"/>
                <TranslateTransform x:Name="Shift" Y="-24"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка приложения-отправителя -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Background="#26262C"
                    ClipToBounds="True" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="IconLetter" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="IconImage" Stretch="Uniform" Margin="5"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppText" Foreground="#8A8A93" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BodyText" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"
                           MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
