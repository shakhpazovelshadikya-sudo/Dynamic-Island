<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island — Настройки"
        Icon="assets/DynamicIsland.ico"
        Width="580" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#111114"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Переключатель в стиле iOS -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#3A3A40">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#34C759"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1C1C21"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A93"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9A9AA3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E2E36"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Маленькая кнопка ▲ / ▼ для порядка вкладок -->
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2A2A30" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню разделов -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,0">
            <TextBlock Text="Настройки" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,2"/>
            <TextBlock Text="Dynamic Island" Foreground="#8A8A93" FontSize="12" Margin="12,0,0,18"/>

            <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="Основные" IsChecked="True" Tag="General" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavIsland" Style="{StaticResource NavItem}" Content="Остров" Tag="Island" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavSize" Style="{StaticResource NavItem}" Content="Размер" Tag="Size" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavTabs" Style="{StaticResource NavItem}" Content="Вкладки" Tag="Tabs" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavPet" Style="{StaticResource NavItem}" Content="Питомец" Tag="Pet" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavNotif" Style="{StaticResource NavItem}" Content="Уведомления" Tag="Notif" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="О программе" Tag="About" Checked="Nav_Checked"/>
        </StackPanel>

        <!-- Содержимое разделов -->
        <Grid Grid.Row="0" Grid.Column="1">

            <!-- Основные -->
            <StackPanel x:Name="PanelGeneral">
                <TextBlock Text="Основные" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,120,0">
                            <TextBlock Text="Язык острова" Style="{StaticResource Title}"/>
                            <TextBlock Text="Язык интерфейса. Изменение применится после перезапуска острова" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="LanguageBtn" Style="{StaticResource DialogButton}" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Language_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="AutoHint" Text="Остров будет запускаться при входе в Windows" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Остров -->
            <StackPanel x:Name="PanelIsland" Visibility="Collapsed">
                <TextBlock Text="Остров" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Отступ сверху" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="MarginValue" Foreground="#CCCCCC" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="MarginSlider" Minimum="0" Maximum="40" TickFrequency="1"
                                IsSnapToTickEnabled="True" Margin="0,10,0,0"
                                ValueChanged="MarginSlider_ValueChanged"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,16,0">
                            <TextBlock Text="Монитор" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="MonitorText" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button Style="{StaticResource DialogButton}" Content="Сменить" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Monitor_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Раскрывать при смене трека" Style="{StaticResource Title}"/>
                            <TextBlock Text="Остров сам откроется на 3 секунды" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ExpandSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,56,0">
                            <TextBlock Text="Анимация смены языка" Style="{StaticResource Title}"/>
                            <TextBlock Text="При переключении раскладки остров показывает EN → RU" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="LangSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,56,0">
                            <TextBlock Text="Скрывать в полноэкранном режиме" Style="{StaticResource Title}"/>
                            <TextBlock Text="Когда игра или видео открыты на весь экран, остров прячется сам" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,56,0">
                            <TextBlock Text="История буфера обмена" Style="{StaticResource Title}"/>
                            <TextBlock Text="Запоминать скопированный текст для вкладки «Буфер». Только в памяти, на диск не пишется; при выключении история стирается" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ClipSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Размер -->
            <StackPanel x:Name="PanelSize" Visibility="Collapsed">
                <TextBlock Text="Размер" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Макс. ширина капсулы" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="CompactMaxValue" Foreground="#CCCCCC" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Длинное название трека растягивает капсулу до этой ширины, дальше текст обрезается" Style="{StaticResource Hint}"/>
                        <Slider x:Name="CompactMaxSlider" Minimum="200" Maximum="420" TickFrequency="10"
                                IsSnapToTickEnabled="True" Margin="0,10,0,0" ValueChanged="Size_Changed"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Макс. ширина острова" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="ExpandedMaxValue" Foreground="#CCCCCC" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Раскрытый остров расширяется под длинное название и исполнителя до этого предела" Style="{StaticResource Hint}"/>
                        <Slider x:Name="ExpandedMaxSlider" Minimum="460" Maximum="800" TickFrequency="10"
                                IsSnapToTickEnabled="True" Margin="0,10,0,0" ValueChanged="Size_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Вкладки -->
            <StackPanel x:Name="PanelTabs" Visibility="Collapsed">
                <TextBlock Text="Вкладки" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Включай и выключай вкладки острова, порядок меняется стрелками. «Главная» отключить нельзя." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}" Padding="16,8">
                    <StackPanel x:Name="TabsList"/>
                </Border>
            </StackPanel>

            <!-- Питомец -->
            <StackPanel x:Name="PanelPet" Visibility="Collapsed">
                <TextBlock Text="Питомец" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Живёт в левой части капсулы: сидит, моргает, виляет хвостом, гуляет и спит. Когда играет музыка — пританцовывает, а при смене трека подпрыгивает." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                <WrapPanel x:Name="PetList"/>
            </StackPanel>

            <!-- Уведомления -->
            <StackPanel x:Name="PanelNotif" Visibility="Collapsed">
                <TextBlock Text="Уведомления" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,56,0">
                            <TextBlock Text="Показывать уведомления" Style="{StaticResource Title}"/>
                            <TextBlock Text="Сообщения из других приложений выезжают под островом" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="NotifSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Состояние" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="NotifStatus" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource DialogButton}" Content="Обновить статус" Click="RefreshStatus_Click"/>
                            <Button Style="{StaticResource DialogButton}" Content="Журнал ошибок" Margin="8,0,0,0" Click="OpenLog_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Нужен доступ к уведомлениям: Параметры Windows → Конфиденциальность и безопасность → Уведомления." Style="{StaticResource Hint}"/>
                        <Button Style="{StaticResource DialogButton}" Content="Показать пример" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Test_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- О программе -->
            <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                <TextBlock Text="О программе" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Dynamic Island для Windows" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="AboutVersion" Text="Версия 1.0" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="UpdateBtn" Style="{StaticResource DialogButton}" Content="Обновить" Background="#3E9E5F" Visibility="Collapsed" Click="Update_Click"/>
                            <Button x:Name="CheckUpdateBtn" Style="{StaticResource DialogButton}" Content="Проверить обновления" Background="#2A2A31" Click="CheckUpdate_Click"/>
                        </StackPanel>
                        <TextBlock Text="Погода: open-meteo.com. Город определяется автоматически по IP." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        <TextBlock Text="Журнал ошибок: %AppData%\DynamicIsland\log.txt" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        <Button Style="{StaticResource DialogButton}" Content="Открыть журнал ошибок" Background="#2A2A31"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenLog_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Файл настроек" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="AboutPath" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource DialogButton}" Content="Отмена" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource DialogButton}" Content="Сохранить" Background="#5A78FF" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
